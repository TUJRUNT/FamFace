{
  "name": "famface",
  "version": "1.0.0",
  "description": "Real-time chat application using Socket.io",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --windows",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.5.4",
    "multer": "^1.4.5"
  },
  "devDependencies": {
    "electron": "^26.2.0",
    "electron-builder": "^24.1.0"
  },
  "build": {
    "productName": "FamFace",
    "appId": "com.ahmed.famface",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    }
  }
}
